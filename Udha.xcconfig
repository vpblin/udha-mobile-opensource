// Build settings that identify *your* build of Udha. Nothing here is secret,
// but nothing here should be another person's either.
//
// Put your own values in Local.xcconfig next to this file (git-ignored) —
// see Local.xcconfig.example. With every value below left empty the app still
// builds and runs (the simulator's mock host works offline); signing in and
// reaching a real desktop need the relay and Auth0 values.

// Bundle id of the app; the widget extension is $(UDHA_BUNDLE_ID).UdhaWidgets.
// The Auth0 callback URL scheme is the bundle id too.
UDHA_BUNDLE_ID = com.example.udha

// Apple signing team. Empty is fine for the simulator; a device build needs one.
DEVELOPMENT_TEAM =

// Your relay's host name, no scheme — the app dials wss://<host>/client.
UDHA_RELAY_HOST =

// Your Auth0 tenant (e.g. your-tenant.us.auth0.com) and the Native
// application's client id. Both are public values; no client secret is used.
UDHA_AUTH0_DOMAIN =
UDHA_AUTH0_CLIENT_ID =

// The Auth0 API identifier. Empty means https://<UDHA_RELAY_HOST>, which is the
// convention. xcconfig treats // as a comment, so a full URL here must be
// written with an empty substitution between the slashes: https:/$()/api.example.com
UDHA_AUTH0_AUDIENCE =

#include? "Local.xcconfig"
